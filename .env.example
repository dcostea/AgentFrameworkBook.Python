# Copy to .env; never commit credentials. Only configure providers you use.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_ID=gpt-5.4-mini
# Optional Responses model; defaults to OPENAI_CHAT_MODEL_ID.
OPENAI_RESPONSES_MODEL_ID=
OPENAI_BASE_URL=
# Chapter 07 semantic retrieval: an embedding model supporting 1536 dimensions.
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small

# Azure v1 routing accepts either the resource URL or its /openai/v1/ URL.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Optional legacy API version. Leave blank for the v1 API.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=
# Chapter 07 semantic retrieval: an embedding deployment supporting 1536 dimensions.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# A deployment supporting input audio is required for --mode audio.
AZURE_OPENAI_AUDIO_ENDPOINT=
AZURE_OPENAI_AUDIO_API_KEY=
AZURE_OPENAI_AUDIO_DEPLOYMENT_NAME=
AZURE_OPENAI_AUDIO_API_VERSION=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Chapter 08 loopback HTTP MCP server/client port.
MCP_PORT=3001

# Chapter 11 telemetry export remains opt-in via CLI.
OTEL_EXPORTER_OTLP_ENDPOINT=
ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL=
# Standard-OTel identity metadata only, not Agent 365 authentication.
AGENT365_TENANT_ID=
AGENT365_CLIENT_ID=

# Local ONNX GenAI model directories (containing genai_config.json).
ONNX_MODEL_PATH=
ONNX_MULTIMODAL_MODEL_PATH=
ONNX_PROVIDER=cpu
# Optional overrides:
ONNX_IMAGE_PATH=
ONNX_CHAT_TEMPLATE=

# The C# chat-options example uses 5, which truncates most JSON responses.
CHATBOT_MAX_OUTPUT_TOKENS=512
